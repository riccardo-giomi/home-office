<%# The picker of the Links section: a kind at a time (tabs, each with an address), a search by title, a button on each result.
    In change mode the buttons patch the link being changed instead of making a new one. %>
<%= turbo_frame_tag(turbo_frame_request_id || "links-section-picker") do %>
  <% unless params[:close] %>
    <%= render(Core::UI::PanelComponent.new(id: "link-picker-panel", title: @change ? t(".title_change") : t(".title_add"), data: {controller: "scroll-into-view"})) do %>
      <nav aria-label="<%= t(".kinds") %>" class="mb-3">
        <%= render Core::UI::TabsComponent.new(items: Core::Modules.linkable_kinds.map { |kind| [t(kind.label_key, count: 2), new_link_path(entity_id: @entity.id, kind: kind.key, q: @term.presence, change: @change&.id), kind == @kind] }) %>
      </nav>
      <%= form_with url: new_link_path, method: :get, class: "mb-3 flex flex-wrap items-end gap-2" do |form| %>
        <%= hidden_field_tag :entity_id, @entity.id, id: nil %>
        <%= hidden_field_tag :kind, @kind.key, id: nil %>
        <%= hidden_field_tag :change, @change.id, id: nil if @change %>
        <div class="grow basis-48">
          <%= render Core::UI::FieldComponent.new(form:, attribute: :q, label: t(".search"), as: :search_field, value: @term, autocomplete: "off") %>
        </div>
        <div class="mb-4"><%= render(Core::UI::ButtonComponent.new(type: :submit, variant: :secondary)) { t(".go") } %></div>
      <% end %>
      <%= render(Core::UI::RowListComponent.new(label: t(".results"), empty_text: t(".none"))) do |list| %>
        <% @candidates.results.each do |record| %>
          <% list.with_row(id: "candidate_#{record.id}", detail: link_detail(record), actions: link_candidate_action(record)) { record.for_links.label } %>
        <% end %>
      <% end %>
      <% if @candidates.more? %><p class="mt-2 text-sm"><%= t(".more", count: Core::LinkCandidates::LIMIT) %></p><% end %>
      <p class="mt-3"><%= render(Core::UI::ButtonComponent.new(variant: :ghost, size: :sm, href: new_link_path(entity_id: @entity.id, close: 1))) { t(".close") } %></p>
    <% end %>
  <% end %>
<% end %>
