<%# What every item with a day and times has %>
<%= render Core::UI::FieldComponent.new(form:, attribute: :title, label: item.class.human_attribute_name(:title), required: true, autocomplete: "off") %>
<%= render Core::UI::FieldComponent.new(form:, attribute: :day, label: item.class.human_attribute_name(:day), as: :date_field, required: true) %>
<%= render Core::UI::FieldComponent.new(form:, attribute: :start_time, label: item.class.human_attribute_name(:start_time), as: :time_field, hint: kind_t(item, "times_hint"), data: {time_offset_target: "source", action: "input->time-offset#fill change->time-offset#fill"}) %>
<%= render Core::UI::FieldComponent.new(form:, attribute: :end_time, label: item.class.human_attribute_name(:end_time), as: :time_field, data: {time_offset_target: "target", action: "input->time-offset#markEdited"}) %>
<%= render Core::UI::FieldComponent.new(form:, attribute: :priority, label: item.class.human_attribute_name(:priority), as: :select, choices: priority_choices) %>
<%= render Core::UI::FieldComponent.new(form:, attribute: :notes, label: item.class.human_attribute_name(:notes), as: :text_area, rows: 4) %>
