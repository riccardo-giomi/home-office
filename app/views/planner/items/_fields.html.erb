<%# What every item has; the day and times come from the schedule fields of its type %>
<%= render Core::UI::FieldComponent.new(form:, attribute: :title, label: item.class.human_attribute_name(:title), required: true, autocomplete: "off") %>
<%= render "schedule_fields", form:, item: %>
<%= render Core::UI::FieldComponent.new(form:, attribute: :priority, label: item.class.human_attribute_name(:priority), as: :select, choices: priority_choices) %>
<%= render Core::UI::FieldComponent.new(form:, attribute: :notes, label: item.class.human_attribute_name(:notes), as: :text_area, rows: 4) %>
