<% content_for :title, t(".title") %>
<%= event_frame do %>
  <div class="w-full max-w-md">
    <%= render Core::UI::PageHeaderComponent.new(id: "dialog-title", title: t(".title"), back_href: (event_back_href(@event) unless in_dialog?), back_label: event_back_label) %>
    <%= render "form", event: @event %>
    <%= render(Core::UI::FormActionsComponent.new) do |actions| %>
      <% actions.with_primary do %>
        <%= render(Core::UI::ButtonComponent.new(type: :submit, form: "event-form")) { t("planner.events.form.submit") } %>
      <% end %>
    <% end %>
  </div>
<% end %>
