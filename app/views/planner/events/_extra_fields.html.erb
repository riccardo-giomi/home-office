<%= render Core::UI::FieldComponent.new(form:, attribute: :tracks_done, label: item.class.human_attribute_name(:tracks_done), as: :check_box) %>
<%# An event of a series shows the rule of its series and asks which events the change is about. An event that exists and
    is not part of one cannot become a repeating one, and one made to be linked is a single event %>
<% if item.occurrence? %>
  <%= render "planner/events/repeat_fields", item:, never: false %>
  <%= render "planner/series/scope_fields", scopes: Planner::Recurrence::ScopeChoice::EDIT, choice: scope_choice %>
<% elsif item.new_record? && linked_source.nil? %>
  <%= render "planner/events/repeat_fields", item:, never: true %>
<% end %>
