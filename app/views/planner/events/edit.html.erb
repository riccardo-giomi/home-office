<% content_for :title, t(".title", title: @event.title_was) %>
<div class="w-full max-w-md">
  <%= render Core::UI::PageHeaderComponent.new(title: t(".title", title: @event.title_was), back_href: planner_event_path(@event, back: back_param), back_label: t("planner.events.back.event")) %>
  <%= render "form", event: @event %>
  <%= render(Core::UI::FormActionsComponent.new) do |actions| %>
    <% actions.with_primary do %>
      <%= render(Core::UI::ButtonComponent.new(type: :submit, form: "event-form")) { t("planner.events.form.submit") } %>
    <% end %>
    <% actions.with_danger do %>
      <%= render(Core::UI::ModalComponent.new(id: "delete-event", title: t(".delete_title"), trigger: t(".delete"), trigger_variant: :danger)) do %>
        <p class="mb-4"><%= t(".delete_warning", title: @event.title_was) %></p>
        <%= form_with url: planner_event_path(@event), method: :delete do %>
          <%= hidden_field_tag :back, back_param if back_param %>
          <%= render(Core::UI::ButtonComponent.new(type: :submit, variant: :danger)) { t(".delete_confirm") } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
