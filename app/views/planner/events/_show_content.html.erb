<%# The details of an event: a full page, or the content of the dialog. %>
<%# In the dialog there is no way back to draw (the dialog closes), and a tick redraws this part. %>
<div class="w-full max-w-2xl">
  <%= render Core::UI::PageHeaderComponent.new(id: "dialog-title", title: event.title, back_href: (event_back_href(event) unless in_dialog?), back_label: event_back_label) %>
  <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-[8rem_1fr]">
    <dt class="font-semibold"><%= t("planner.events.show.when") %></dt>
    <dd>
      <%= format_date(event.day) %>
      <% if event.starts_at %>
        <br><%= format_time(event.starts_at, zone: event.time_zone) %>&ndash;<%= format_time(event.ends_at, zone: event.time_zone) %>
      <% else %>
        <br><%= t("core.ui.calendar_entry.all_day") %>
      <% end %>
    </dd>
    <% if event.tracks_done? %>
      <dt class="font-semibold"><%= t("planner.events.show.done") %></dt>
      <dd class="flex items-center gap-2">
        <%= completion_check(event) %>
        <% if event.done? %><span><%= t("planner.events.show.done_at_html", time: format_datetime(event.done_at)) %></span><% end %>
      </dd>
    <% end %>
    <% if event.notes.present? %>
      <dt class="font-semibold"><%= t("planner.events.show.notes") %></dt>
      <dd class="whitespace-pre-line wrap-anywhere"><%= event.notes %></dd>
    <% end %>
  </dl>
  <div class="mt-8">
    <%= render(Core::UI::ButtonComponent.new(href: edit_planner_event_path(event, back: back_param))) { t("planner.events.show.edit") } %>
  </div>
</div>
