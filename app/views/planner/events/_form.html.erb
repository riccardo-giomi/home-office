<%# time-offset: typing a start fills the end 30 minutes later until the end is typed by hand %>
<%= form_with model: event, id: "event-form", data: {controller: "time-offset", time_offset_minutes_value: Planner::Event::DEFAULT_DURATION.in_minutes.to_i} do |form| %>
  <%= hidden_field_tag :back, back_param if back_param %>
  <%= render Core::UI::ErrorSummaryComponent.new(record: event) %>
  <%= render Core::UI::FieldComponent.new(form:, attribute: :title, label: Planner::Event.human_attribute_name(:title), required: true, autocomplete: "off") %>
  <%= render Core::UI::FieldComponent.new(form:, attribute: :day, label: Planner::Event.human_attribute_name(:day), as: :date_field, required: true) %>
  <%= render Core::UI::FieldComponent.new(form:, attribute: :start_time, label: Planner::Event.human_attribute_name(:start_time), as: :time_field, hint: t(".times_hint"), data: {time_offset_target: "source", action: "input->time-offset#fill change->time-offset#fill"}) %>
  <%= render Core::UI::FieldComponent.new(form:, attribute: :end_time, label: Planner::Event.human_attribute_name(:end_time), as: :time_field, data: {time_offset_target: "target", action: "input->time-offset#markEdited"}) %>
  <%= render Core::UI::FieldComponent.new(form:, attribute: :notes, label: Planner::Event.human_attribute_name(:notes), as: :text_area, rows: 4) %>
  <%= render Core::UI::FieldComponent.new(form:, attribute: :tracks_done, label: Planner::Event.human_attribute_name(:tracks_done), as: :check_box) %>
<% end %>
