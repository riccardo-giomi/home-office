<%# Refreshes in place when the page comes back; morphing keeps the scroll position and the focus %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%# The numbers change while the page is open, so Turbo must not cache the page for the Back button %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<div data-controller="refresh-after-absence" data-refresh-after-absence-seconds-value="60">
  <%# Core::Overview sends a refresh on this stream when a number of the page changes. It is inside the element of the controller, which watches its connection %>
  <%= turbo_stream_from(*Core::Overview.stream(Current.user.id)) %>
  <h1 class="text-3xl font-bold"><%= t(".title") %></h1>
  <p class="my-4"><%= t(".signed_in_as", email: Current.user.email_address) %></p>
  <%= render(Core::UI::CardGridComponent.new(label: t(".cards"))) do |grid| %>
    <% @cards.each do |card| %>
      <% grid.with_card do %>
        <%= render Core::UI::StatCardComponent.new(
              title: t(card.title_key), href: card.href, narrow_href: card.narrow_href,
              total: (t(card.total_key, count: card.total) if card.total_key),
              lines: card.lines.map { |line| {label: t(line.label_key, count: line.count), count: line.count, href: line.href, narrow_href: line.narrow_href} }
            ) %>
      <% end %>
    <% end %>
  <% end %>
</div>
