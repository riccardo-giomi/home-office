<% content_for :title, t(".title") %>
<div class="w-full">
  <%= render Core::UI::PageHeaderComponent.new(title: t(".title")) %>
  <%= render(Core::UI::PageToolbarComponent.new) do |toolbar| %>
    <% toolbar.with_leading do %>
      <%= render(Core::UI::ButtonComponent.new(href: new_admin_user_path)) { t(".new") } %>
    <% end %>
  <% end %>
  <%# Plain table markup; emails wrap so 320 px does not scroll sideways %>
  <table class="w-full text-left">
    <caption class="sr-only"><%= t(".caption") %></caption>
    <thead>
      <tr>
        <th scope="col" class="py-2 pe-2"><%= User.human_attribute_name(:email_address) %></th>
        <th scope="col" class="py-2 pe-2"><%= User.human_attribute_name(:role) %></th>
        <th scope="col" class="py-2"><span class="sr-only"><%= t(".actions") %></span></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr class="border-t border-base-300">
          <td class="py-2 pe-2 break-all">
            <%= user.email_address %>
            <% if user.deactivated? %><span class="block text-sm text-base-content/80"><%= t(".deactivated") %></span><% end %>
          </td>
          <td class="py-2 pe-2"><%= t("users.roles.#{user.role}") %></td>
          <td class="py-2">
            <div class="flex flex-wrap items-center gap-2">
              <%= render(Core::UI::LinkComponent.new(href: edit_admin_user_path(user))) do %><%= t(".edit") %><span class="sr-only"> <%= user.email_address %></span><% end %>
              <% unless user == Current.user %>
                <%= form_with url: admin_user_deactivation_path(user), method: (user.active? ? :post : :delete) do %>
                  <%= render(Core::UI::ButtonComponent.new(type: :submit, variant: :secondary, size: :xs)) do %><%= user.active? ? t(".deactivate") : t(".reactivate") %><span class="sr-only"> <%= user.email_address %></span><% end %>
                <% end %>
              <% end %>
              <% if hard_delete_users? && user.removable? && user != Current.user %>
                <%= render(Core::UI::ModalComponent.new(id: "delete-user-#{user.id}", title: t(".delete_title"), trigger: safe_join([t(".delete"), tag.span(" #{user.email_address}", class: "sr-only")]), trigger_variant: :danger, trigger_size: :xs)) do %>
                  <p class="mb-4"><%= t(".delete_warning", email: user.email_address) %></p>
                  <%= form_with url: admin_user_path(user), method: :delete do %>
                    <%= render(Core::UI::ButtonComponent.new(type: :submit, variant: :danger)) { t(".delete_confirm") } %>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
