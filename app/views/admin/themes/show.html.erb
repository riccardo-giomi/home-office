<% content_for :title, t(".title") %>
<%= render Core::UI::PageHeaderComponent.new(title: t(".title")) %>
<p class="mb-6"><%= t(".intro") %></p>

<section data-typography class="mb-10">
  <h2 class="text-xl font-bold mb-2 border-b border-base-300 pb-1"><%= t(".typography") %></h2>
  <p class="text-3xl font-bold"><%= t(".sample_title") %></p>
  <p class="text-2xl font-bold"><%= t(".sample_page") %></p>
  <p class="text-xl font-semibold"><%= t(".sample_section") %></p>
  <p class="my-2"><%= t(".sample_body") %></p>
  <p class="text-base-content/70 my-2"><%= t(".sample_muted") %></p>
  <p class="my-2"><%= t(".sample_numbers") %> <span class="font-mono">1 234,56</span></p>
</section>

<% @previews.each do |preview| %>
  <section data-preview="<%= preview.preview_name %>" class="mb-10">
    <h2 class="text-xl font-bold mb-2 border-b border-base-300 pb-1 break-all"><code><%= preview.name.delete_suffix("Preview") %></code></h2>
    <% preview.examples.each do |example| %>
      <div data-example="<%= example %>" <%= tag.attributes(data: {tokens: (true if preview.name.include?("ThemeTokens"))}) %> class="mb-4">
        <h3 class="text-sm font-semibold text-base-content/70 mb-2"><%= example.humanize %></h3>
        <%= render_preview_example(preview, example) %>
      </div>
    <% end %>
  </section>
<% end %>
