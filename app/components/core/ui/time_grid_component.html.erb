<div data-controller="grid-scroll" data-grid-scroll-mode-value="<%= scroll_mode %>" class="grid <%= single_day? ? "grid-cols-[3.5rem_minmax(0,1fr)]" : "grid-cols-[3.5rem_repeat(7,minmax(0,1fr))]" %> grid-rows-[auto_auto_repeat(96,1.25rem)] gap-x-0.5">
  <div aria-hidden="true" class="grid grid-rows-subgrid col-start-1 row-start-3 row-span-96 text-xs text-base-content/80">
    <% 24.times do |hour| %>
      <div class="row-span-4 scroll-mt-20" data-hour="<%= hour %>"><%= hour_label(hour) %></div>
    <% end %>
  </div>
  <% day_views.each do |view| %>
    <section class="grid grid-rows-subgrid row-start-1 row-span-98 col-start-<%= view.column %> border-s border-base-300">
      <h2 class="text-center text-sm font-bold" <%= tag.attributes("aria-current": ("date" if view.date == @today)) %>>
        <span class="<%= "inline-block rounded-full bg-primary px-2 text-primary-content" if view.date == @today %>">
          <% if single_day? %>
            <%= I18n.t("date.day_names")[view.date.wday] %> <%= helpers.format_date(view.date) %>
          <% else %>
            <span aria-hidden="true"><%= I18n.t("date.abbr_day_names")[view.date.wday] %> <%= view.date.day %></span><span class="sr-only"><%= I18n.l(view.date, format: :long) %></span>
          <% end %>
        </span>
      </h2>
      <% if view.all_day.any? || view.result.overflow.any? %>
        <ul class="row-start-2 px-0.5">
          <% view.all_day.each do |attributes| %>
            <li class="rounded border border-base-300 bg-base-100 p-1 text-sm"><%= render_entry(attributes) %></li>
          <% end %>
          <% if view.result.overflow.any? %>
            <li><%= link_to t("core.ui.time_grid.more", count: view.result.overflow.size), @agenda_href.call(view.date), class: "link inline-flex min-h-6 items-center text-sm" %></li>
          <% end %>
        </ul>
      <% end %>
      <% if view.entries.empty? %>
        <p class="sr-only"><%= t("core.ui.time_grid.empty") %></p>
      <% end %>
      <ul class="relative grid grid-rows-subgrid grid-cols-1 row-start-3 row-span-96 bg-[repeating-linear-gradient(to_bottom,transparent_0,transparent_4.9rem,var(--color-base-300)_4.9rem,var(--color-base-300)_5rem)]">
        <% if view.now_minutes %>
          <%# Placed by the script (an inline style would be refused by the CSP); invisible until then %>
          <li aria-hidden="true" class="pointer-events-none invisible absolute inset-x-0 z-10 border-t-2 border-primary before:absolute before:-top-[5px] before:-start-1 before:size-2 before:rounded-full before:bg-primary"
            data-controller="now-marker" data-now-marker-minutes-value="<%= view.now_minutes %>" data-now-marker-rendered-at-value="<%= rendered_at_ms %>"></li>
        <% end %>
        <% view.clusters.each do |cluster| %>
          <li class="grid grid-rows-subgrid gap-x-0.5 row-start-<%= cluster.first_row %> row-span-<%= cluster.rows %> grid-cols-<%= cluster.columns %>">
            <ul class="contents">
              <% cluster.placements.each do |placement| %>
                <li class="<%= entry_classes(cluster, placement) %>"><%= render_entry(placement.entry.attributes, compact: compact?(placement)) %></li>
              <% end %>
            </ul>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
