<%# autofocus is honored by Turbo after a 422 render, so keyboard and screen reader users land here %>
<div id="<%= @id %>" role="alert" tabindex="-1" <%= "autofocus" if @autofocus %> data-controller="focus-link" class="alert alert-soft alert-error alert-vertical text-start justify-start justify-items-start mb-6">
  <h2 class="font-bold"><%= t("core.ui.error_summary.title", count: @record.errors.count) %></h2>
  <ul class="list-none p-0">
    <% items.each do |message, target| %>
      <li><% if target %><a class="link inline-flex items-center min-h-6" href="#<%= target %>" data-action="focus-link#focus"><%= message %></a><% else %><%= message %><% end %></li>
    <% end %>
  </ul>
</div>
