<%# turbo:before-cache closes it, so a cached page never comes back with a plain open dialog %>
<div data-controller="modal" data-action="turbo:before-cache@document->modal#close">
  <%= render(Core::UI::ButtonComponent.new(variant: @trigger_variant, size: @trigger_size, "aria-haspopup": "dialog", data: {action: "modal#open"})) { @trigger } %>
  <dialog id="<%= @id %>" class="modal" aria-labelledby="<%= @id %>-title" data-modal-target="dialog" data-action="click->modal#backdrop">
    <div class="modal-box">
      <h2 id="<%= @id %>-title" class="text-lg font-bold"><%= @title %></h2>
      <div class="py-4"><%= content %></div>
      <form method="dialog" class="modal-action">
        <%= render(Core::UI::ButtonComponent.new(type: :submit, variant: :ghost)) { t("core.ui.modal.close") } %>
      </form>
    </div>
  </dialog>
</div>
